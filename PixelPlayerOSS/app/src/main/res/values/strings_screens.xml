    <string name="word_delimiter_help_title">How Word Delimiters Work</string>
    <string name="word_delimiter_help_body">Word delimiters are matched case-insensitively with spaces around them.\n\nSingle-character delimiters (like \"x\") require spaces on both sides to avoid false matches.\n\nExamples:\n  \"Drake feat. Rihanna\" -&gt; Drake, Rihanna\n  \"Marshmello x Bastille\" -&gt; Marshmello, Bastille\n  \"A vs. B\" -&gt; A, B</string>
