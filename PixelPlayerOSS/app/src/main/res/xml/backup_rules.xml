<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Server credentials from the removed Navidrome / Jellyfin / ListenBrainz support.
        Nothing writes or reads these files any more - LegacyCloudDataCleanup deletes them
        from app-private storage on startup - but an old backup set or a device transfer
        could still carry them, so they stay excluded here as a second line of defence.
    -->
    <exclude domain="sharedpref" path="jellyfin_prefs.xml"/>
    <exclude domain="sharedpref" path="navidrome_prefs.xml"/>

    <exclude domain="sharedpref" path="jellyfin_prefs_plain.xml"/>
    <exclude domain="sharedpref" path="navidrome_prefs_plain.xml"/>

    <exclude domain="sharedpref" path="listenbrainz_prefs.xml"/>
    <exclude domain="sharedpref" path="listenbrainz_prefs_plain.xml"/>

    <exclude domain="file" path="datastore/settings.preferences_pb"/>
    <!-- Cache of downloaded remote tracks; the feature and its tracking table are gone. -->
    <exclude domain="file" path="cloud_downloads/"/>

    <exclude domain="sharedpref" path="crash_handler_prefs.xml"/>
    <exclude domain="sharedpref" path="maintenance_security.xml"/>
    <!-- Device-local diagnostic and containment state (AUD-098): restoring it elsewhere, without the
         excluded settings store it belongs with, would bring back e.g. a FORCE_ANDROID override. -->
    <exclude domain="sharedpref" path="maintenance_overrides.xml"/>
    <exclude domain="sharedpref" path="dap_containment.xml"/>
    <exclude domain="sharedpref" path="product_mode.xml"/>
</full-backup-content>
