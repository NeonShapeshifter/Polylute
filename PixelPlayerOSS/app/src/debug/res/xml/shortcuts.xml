<?xml version="1.0" encoding="utf-8"?>
<!--
  B35 (R6): the debug build is another app (`app.polylute.debug`), and a static shortcut's `targetPackage` has to be the package of the app that
  declares it (resource XML takes no `${applicationId}`), so the debug source set carries its own copy of main's `shortcuts.xml` with that one value
  changed. Keep the two in step.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shuffle_all"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_shuffle"
        android:shortcutShortLabel="@string/shortcut_shuffle_short"
        android:shortcutLongLabel="@string/shortcut_shuffle_long">
        <intent
            android:action="com.lostf1sh.pixelplayeross.ACTION_SHUFFLE_ALL"
            android:targetPackage="app.polylute.debug"
            android:targetClass="com.lostf1sh.pixelplayeross.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
